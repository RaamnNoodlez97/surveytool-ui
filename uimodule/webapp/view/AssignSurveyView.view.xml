<mvc:View xmlns:form="sap.ui.layout.form" 
    xmlns="sap.m" 
    xmlns:u="sap.uxap"
    xmlns:layout="sap.ui.layout" 
    xmlns:mvc="sap.ui.core.mvc" 
    xmlns:core="sap.ui.core" 
    controllerName="mta.MTA1.controller.AssignSurveyView">
    <Page showNavButton="true" title="Assign a Survey" navButtonPress=".onNavBack">
        <content>
            <VBox class="sapUiMediumMargin">
                <form:SimpleForm 
                    layout="ResponsiveGridLayout"
                    editable="true"
                    labelSpanXL="3" labelSpanL="3" labelSpanM="4" labelSpanS="12"
                    adjustLabelSpan="false"
                    emptySpanXL="1" emptySpanL="1" emptySpanM="1" emptySpanS="0"
                    columnsXL="2" columnsL="2" columnsM="1">

                    
                    <Title text="Survey Information">
                        <layoutData>
                            <layout:GridData linebreak="true"/>
                        </layoutData>
                    </Title>
                    
                    <Label text="Select Survey" />
                    <Input value="{assignSurveyModel>/surveyId}" placeholder="123" />

                    <Label text="Users (Comma Separated)" />
                    <Input value="{assignSurveyModel>/users}" placeholder="e.g. EU_ASHIRB, EU_PRIYULM" />

                    <Title text="Target Group" class="sapUiMediumMarginTop">
                        <layoutData>
                            <layout:GridData linebreak="true"/>
                        </layoutData>
                    </Title>
                    
                    <Label text="Target Org Data Type" />
                    <Select selectedKey="{assignSurveyModel>/targetOrgDataType}">
                        <core:Item key="Business Unit" text="Business Unit" />
                        <core:Item key="Department" text="Department" />
                        <core:Item key="Company" text="Company" />
                        <core:Item key="Cost Centre" text="Cost Centre" />
                    </Select>

                    <Label text="Target Org Code" />
                    <Input value="{assignSurveyModel>/targetOrgCode}" placeholder="e.g. BU1" />

                    
                    <Title text="Selection Criteria" class="sapUiMediumMarginTop">
                        <layoutData>
                            <layout:GridData linebreak="true"/>
                        </layoutData>
                    </Title>

                    <Label text="Unit of Measure" />
                    <Select selectedKey="{assignSurveyModel>/UnitOfMeasure}">
                        <core:Item key="Percentage" text="Percentage" />
                        <core:Item key="Count" text="Count" />
                    </Select>

                    <Label text="Quantity" />
                    <Input type="Number" value="{assignSurveyModel>/Quantity}" />

                    <Label text="Frequency" />
                    <Select selectedKey="{assignSurveyModel>/Frequency}">
                        <core:Item key="Daily" text="Daily" />
                        <core:Item key="Weekly" text="Weekly" />
                        <core:Item key="Monthly" text="Monthly" />
                        <core:Item key="Quarterly" text="Quarterly" />
                        <core:Item key="Yearly" text="Yearly" />
                        <core:Item key="Once_Off" text="Once Off" />
                    </Select>

                    <Label text="Start Date" />
                    <DatePicker value="{assignSurveyModel>/startDate}" 
                                displayFormat="yyyy-MM-dd" 
                                valueFormat="yyyy-MM-ddTHH:mm:ssZ" />

                    <Label text="End Date" />
                    <DatePicker value="{assignSurveyModel>/endDate}" 
                                displayFormat="yyyy-MM-dd" 
                                valueFormat="yyyy-MM-ddTHH:mm:ssZ" />

                </form:SimpleForm>

                <Button text="Assign Survey" 
                        press=".onAssignSurvey" 
                        type="Emphasized" 
                        class="sapUiSmallMarginTop" 
                        width="200px" />
            </VBox>
        </content>
    </Page>
</mvc:View>
