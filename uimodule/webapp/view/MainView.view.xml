<mvc:View controllerName="mta.MTA1.controller.MainView" xmlns:mvc="sap.ui.core.mvc" displayBlock="true" xmlns="sap.m" xmlns:core="sap.ui.core">
    <Page id="mainPage" title="Survey app">
        <content>
            <VBox>
                <Button text="Show Hello World" press=".onNavigateToContent">
                    <customData>
                        <core:CustomData key="content" value="HelloWorld"/>
                    </customData>
                </Button>
                <Button text="Show SF Principal Propagation" press=".onNavigateToContent">
                    <customData>
                        <core:CustomData key="content" value="SFPrincipal"/>
                    </customData>
                </Button>
                <Button text="Show SF API" press=".onNavigateToContent">
                    <customData>
                        <core:CustomData key="content" value="SFAPI"/>
                    </customData>
                </Button>
                <Button text="Create Survey" press=".onNavigateToCreateSurvey">
                    <customData>
                        <core:CustomData key="content" value="CreateSurveyView"/>
                    </customData>
                </Button>
                <Button text="Assign Survey" press=".onNavigateToAssignSurvey">
                    <customData>
                        <core:CustomData key="content" value="AssignSurveyView"/>
                    </customData>
                </Button>
            </VBox>


            <Label text="Test here:"/>
            <Input id="testInput"/>
            <Button text="Test" press=".onTest">
                <customData>
                    <core:CustomData key="content" value="Testing"/>
                </customData>
            </Button>

        </content>
    </Page>
</mvc:View>
