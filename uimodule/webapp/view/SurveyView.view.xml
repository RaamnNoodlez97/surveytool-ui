<mvc:View 
    xmlns="sap.m" 
    xmlns:u="sap.uxap"
    xmlns:layout="sap.ui.layout" 
    xmlns:mvc="sap.ui.core.mvc" 
    xmlns:core="sap.ui.core" 
    controllerName="mta.MTA1.controller.SurveyView" >
	<Page id="surveyPage" title="{surveyData>/surveyHeader/surveyName}" showNavButton="true" navButtonPress=".onNavBack">
        <content>
            <Wizard id="surveyWizard" complete="onReview" steps="{surveyData>/surveySections}" width="100%">
                <WizardStep title="{surveyData>sectionName}">
                    <layout:Grid defaultSpan="L1 M1 S1" class="sapUiSmallMarginBottom">
                        <Label text="" design="Bold">
                            <layoutData>
                                <layout:GridData span="L7 M10 S12" />
                            </layoutData>
                        </Label>
                        <Text text="{path: 'surveyData>sectionLikertScaleType', formatter: '.formatter.firstScale'}" />
                        <Text text="{path: 'surveyData>sectionLikertScaleType', formatter: '.formatter.secondScale'}" />
                        <Text text="{path: 'surveyData>sectionLikertScaleType', formatter: '.formatter.thirdScale'}" />
                        <Text text="{path: 'surveyData>sectionLikertScaleType', formatter: '.formatter.fourthScale'}" />
                        <Text text="{path: 'surveyData>sectionLikertScaleType', formatter: '.formatter.fifthScale'}" />
                    </layout:Grid>

                    
                    <VBox items="{
                            path: 'surveyData>sectionQuestions',
                            templateShareable: false
                        }">
                        <layout:Grid defaultSpan="L1 M1 S1" hSpacing="2">
                            <Label text="{surveyData>questionText}" design="Bold" class="sapUiTinyMarginTop" wrapping="true">
                                <layoutData>
                                    <layout:GridData span="L7 M10 S12" linebreak="true" />
                                </layoutData>
                            </Label>
                            <RadioButton select=".onRadioSelect">
                                <customData>
                                    <core:CustomData key="value" value="1"/>
                                    <core:CustomData key="questionExternalCode" value="{surveyData>questionExternalCode}"/>
                                </customData>
                            </RadioButton>
                            <RadioButton select=".onRadioSelect">
                                <customData>
                                    <core:CustomData key="value" value="2"/>
                                    <core:CustomData key="questionExternalCode" value="{surveyData>questionExternalCode}"/>
                                </customData>
                            </RadioButton>
                            <RadioButton select=".onRadioSelect">
                                <customData>
                                    <core:CustomData key="value" value="3"/>
                                    <core:CustomData key="questionExternalCode" value="{surveyData>questionExternalCode}"/>
                                </customData>
                            </RadioButton>
                            <RadioButton select=".onRadioSelect">
                                <customData>
                                    <core:CustomData key="value" value="4"/>
                                    <core:CustomData key="questionExternalCode" value="{surveyData>questionExternalCode}"/>
                                </customData>
                            </RadioButton>
                            <RadioButton select=".onRadioSelect">
                                <customData>
                                    <core:CustomData key="value" value="5"/>
                                    <core:CustomData key="questionExternalCode" value="{surveyData>questionExternalCode}"/>
                                </customData>
                            </RadioButton>
                        </layout:Grid>

                    </VBox>
                </WizardStep>
            </Wizard>
        </content>
    </Page>
</mvc:View>