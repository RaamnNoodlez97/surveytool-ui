<mvc:View xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc" xmlns:core="sap.ui.core" controllerName="mta.MTA1.controller.SurveyView" >
	<Page id="surveyPage" title="{surveyData>/surveys/0/survey_name}" showNavButton="true" navButtonPress=".onNavBack">
        <Wizard id="surveyWizard">
            <!-- Step 1 -->
            <WizardStep title="Section 1">
                <VBox>
                    <Label text="How satisfied are you with the internship?" />
                    <RadioButtonGroup id="rbg1" columns="1">
                        <RadioButton text="Very Dissatisfied" />
                        <RadioButton text="Dissatisfied" />
                        <RadioButton text="Neutral" />
                        <RadioButton text="Satisfied" />
                        <RadioButton text="Very Satisfied" />
                    </RadioButtonGroup>
                </VBox>
            </WizardStep>

            <!-- Step 2 -->
            <WizardStep title="Section 2">
                <VBox>
                    <Label text="How satisfied are you with the work you are doing?" />
                    <RadioButtonGroup id="rbg2" columns="1">
                        <RadioButton text="Very Dissatisfied" />
                        <RadioButton text="Dissatisfied" />
                        <RadioButton text="Neutral" />
                        <RadioButton text="Satisfied" />
                        <RadioButton text="Very Satisfied" />
                    </RadioButtonGroup>
                </VBox>
            </WizardStep>

            <!-- Step 3 -->
            <WizardStep title="Submit Survey">
                <VBox>
                    <Text text="Review your responses and click submit." />
                    <Button text="Submit" press="onSubmit" type="Emphasized"/>
                </VBox>
            </WizardStep>
        </Wizard>
    </Page>
</mvc:View>